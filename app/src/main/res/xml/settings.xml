<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="音频响应">
        <SeekBarPreference
            app:key="sensitivity"
            app:title="灵敏度"
            app:defaultValue="10"
            app:showSeekBarValue="true" />
        <SwitchPreferenceCompat
            app:key="adaptiveGain"
            app:title="自适应增益"
            app:summary="安静时自动放大，声音大时自动收，避免频谱贴顶"
            app:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="性能与手感">
        <ListPreference
            app:key="fps"
            app:title="帧率"
            app:entries="@array/fps_labels"
            app:entryValues="@array/fps_values"
            app:defaultValue="15" />
        <ListPreference
            app:key="feel"
            app:title="物理手感"
            app:entries="@array/feel_labels"
            app:entryValues="@array/feel_values"
            app:defaultValue="NORMAL" />
    </PreferenceCategory>

    <PreferenceCategory app:title="视觉">
        <ListPreference
            app:key="rodDensity"
            app:title="模块密度"
            app:entries="@array/density_labels"
            app:entryValues="@array/density_values"
            app:defaultValue="NORMAL" />
        <ListPreference
            app:key="theme"
            app:title="配色主题"
            app:entries="@array/theme_labels"
            app:entryValues="@array/theme_values"
            app:defaultValue="GREEN" />
        <SwitchPreferenceCompat
            app:key="chassis"
            app:title="绿色底盘"
            app:summary="声场下方的椭圆柔光。关掉后只剩模块本身，更干净也更透"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="shake"
            app:title="画面抖动"
            app:summary="低频很猛时整体轻微晃动。晕动敏感或投屏时可以关掉"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="悬浮窗">
        <!--
            范围必须写在 XML 的 android:min / android:max 上。
            SeekBarPreference 内置的 max 是 100，若只在代码里 setMin/setMax，
            解析 XML 时 defaultValue=150 会先被夹成 100，打开设置页就等于把用户的小窗尺寸改小了（实测踩过）。
        -->
        <SeekBarPreference
            app:key="smallSize"
            app:title="小窗大小"
            app:defaultValue="150"
            android:min="100"
            android:max="260"
            app:showSeekBarValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
